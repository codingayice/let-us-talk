# Model credentials are entered per browser in Settings; no server model fallback is used.
DATABASE_PATH=data/let-us-talk.sqlite
PORT=3001

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001
# Set true in production after configuring a transactional email provider.
REQUIRE_EMAIL_VERIFICATION=false
